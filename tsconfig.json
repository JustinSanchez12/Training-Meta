// Editor + full typecheck: app code, tests and config files.
// tsconfig.app.json re-checks src/ alone without Node types, so browser code can't use `process` etc.
{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
