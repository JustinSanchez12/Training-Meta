# Copy to .env.local and fill in real values. Never commit .env.local.
# Only VITE_-prefixed variables are exposed to the browser. Never put a secret in one.

# --- Supabase (public, browser-safe) --- Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Supabase (server-only, used in api/ functions and scripts) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- APE (optional AI layer, server-only, see docs/ape-api.md) ---
APE_API_KEY=

# --- E2E tests ---
E2E_BASE_URL=http://localhost:4173
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
